<?xml version="1.0" encoding="utf-8"?>
<!--
  This app stores the user's personal finance records, so it opts out of every
  Android 12+ data extraction path. Domain "root" covers the app's
  credential-encrypted storage (files, databases, shared prefs, cache); domain
  "device_root" covers the separate device-encrypted storage
  (createDeviceProtectedStorageContext()), which this app does not currently
  use but which is excluded here too so a future use is covered without
  another manifest change. Together they are everything
  android:fullBackupContent="false" already excludes on older versions.
  android:allowBackup="false" on the <application> element disables the
  legacy Auto Backup and Backup Manager paths this file does not cover.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
