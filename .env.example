# Example environment file for docker compose.
#
# Copy it to .env next to the compose file you launch, then edit the paths:
#
#   cp .env.example .env
#
# Compose reads .env from the directory that holds the compose file, so every directory
# you run docker compose from needs its own copy. .env is gitignored, .env.example is not.

# Absolute host paths for the backend data and config. Edit both lines and replace
# youruser with your account name.
#
# Set them, do not leave them to the fallback. The compose file falls back to
# ${HOME}/.local/share/finguard and ${HOME}/.config/finguard, and ${HOME} is expanded in
# the environment of the process that runs compose, not by the user who typed the
# command. `sudo docker compose up -d` sets HOME to /root, so the bind mounts resolve
# under /root, where the desktop user cannot read them. A value set here wins over the
# fallback and survives sudo. Docker creates a missing path as an empty root owned
# directory instead of failing, so check the spelling.
FINGUARD_DATA_DIR=/home/youruser/.local/share/finguard
FINGUARD_CONFIG_DIR=/home/youruser/.config/finguard

# Host UID and GID that own the files in the mounted directories. The container starts
# as root and its entrypoint chowns the mounts to these values. Get yours with `id -u`
# and `id -g`.
#
# Rootless Podman is the exception: use PUID=0 and PGID=0 there, because container UID 0
# maps to your host user, and any other value lands in the subuid range at 100000 and
# up, where you cannot read your own files.
PUID=1000
PGID=1000

# Backend port, also used as the frontend proxy target.
FINGUARD_PORT=3111

# FINGUARD_SYNC_PORT is the desktop's sync listener port, published to the local
# network so phones can reach it while pairing.
FINGUARD_SYNC_PORT=3112
