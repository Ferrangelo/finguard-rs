# Copy to .env next to the compose file, then adjust.
# Compose reads .env from the directory the compose file is in.

# Host UID and GID that will own the files in the mounted directories.
PUID=1000
PGID=1000

# Absolute host paths for the backend data and config. Set these when compose may run
# with a different HOME than the desktop user, for example under sudo, where HOME
# becomes /root. When they are unset, the compose file falls back to
# ${HOME}/.local/share/finguard and ${HOME}/.config/finguard.
# FINGUARD_DATA_DIR=/home/youruser/.local/share/finguard
# FINGUARD_CONFIG_DIR=/home/youruser/.config/finguard

# Backend port, also used by the frontend proxy target.
# FINGUARD_PORT=3111
